# LAMMPS input script for ReaxFF simulation
# Generated by PoreReax package
{% if SIMNUMBER == 0 %}
boundary p p p
units real
atom_style full
read_data system.data
{% else %}
read_restart run_{{ SIMNUMBER - 1 }}.data
{% endif %}
pair_style reaxff NULL safezone 3.0 mincap 150
pair_coeff * * reax.ffield {{ ATOMS }}
fix myqeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff maxiter 400

timestep {{ TIMESTEP }}

thermo {{ THERMO_FREQ }}
thermo_style custom step temp press pe ke etotal vol density
dump trajdump all custom {{ DUMP_FREQ }} run_{{ SIMNUMBER }}.lammpstrj id type x y z vx vy vz
dump_modify trajdump sort id
fix myspec all reaxff/species 1 1 {{ DUMP_FREQ }} run_{{ SIMNUMBER }}.species element {{ ATOMS }}
fix bond all reaxff/bonds {{ DUMP_FREQ }} run_{{ SIMNUMBER }}.bonds
fix removeMom all momentum 100 linear 1 1 1 rescale
restart 10000 checkpoint_a.restart checkpoint_b.restart

{% if FROZEN_ATOMS -%}
{%- for name, type_id in FROZEN_ATOMS.items() -%}
group {{ name }} type {{ type_id }}
{% endfor %}
group frozen union{% for name in FROZEN_ATOMS.keys() %} {{ name }}{% endfor %}
fix freeze frozen setforce 0.0 0.0 0.0
velocity frozen set 0.0 0.0 0.0

group mobile subtract all frozen
compute mobileTemp mobile temp
compute_modify mobileTemp extra/dof 0
thermo_modify temp mobileTemp
{% endif -%}
{% if SIMULATIONTYPE == "nvt" %}
fix integrate {% if FROZEN_ATOMS -%}mobile{% else %}all{% endif %} nvt temp {{ TEMP }} {{ TEMP }} 100.0
{% elif SIMULATIONTYPE == "npt" %}
fix integrate {% if FROZEN_ATOMS -%}mobile{% else %}all{% endif %} npt temp {{ TEMP }} {{ TEMP }} 100.0 iso {{ PRESS }} {{ PRESS }} 1000.0
{% elif SIMULATIONTYPE == "nve" %}
fix integrate {% if FROZEN_ATOMS -%}mobile{% else %}all{% endif %} nve
{% endif %}
{%- if FROZEN_ATOMS -%}
fix_modify integrate temp mobileTemp
{% endif %}
{% if IMAGE_DUMP_ENABLED -%}
# Image dump regions and dumps
variable img_xmid equal 0.5*(xlo+xhi)
variable img_ymid equal 0.5*(ylo+yhi)
variable img_zmid equal 0.5*(zlo+zhi)
region image_half_xy block INF INF INF INF INF ${img_zmid} units box
region image_half_xz block INF INF INF ${img_ymid} INF INF units box
region image_half_yz block INF ${img_xmid} INF INF INF INF units box
{% for image in IMAGE_DUMPS %}
dump imagedump_{{ image.dump_id }} all image {{ image.dump_freq }} figures/image_{{ image.dump_id }}_{{ image.plane }}-*.jpg {{ image.type }} type size {{ image.image_width }} {{ image.image_height }} view {{ image.view_theta }} {{ image.view_phi }} center s {{ image.center_x }} {{ image.center_y }} {{ image.center_z }} zoom {{ image.zoom }} {{ image.kwargs }}
dump_modify imagedump_{{ image.dump_id }} region {{ image.region_id }}
{%- if image.color_modify %}
{{ image.color_modify }}
{%- endif -%}
{%- if image.size_modify %}
{{ image.size_modify }}
{%- endif -%}
{% endfor -%}
{% endif %}

run {{ NSTEPS }}

# Cleanup
undump trajdump
unfix myspec
unfix bond
unfix removeMom
unfix integrate
{% if IMAGE_DUMP_ENABLED -%}
{% for image in IMAGE_DUMPS -%}
undump imagedump_{{ image.dump_id }}
{% endfor %}
{% endif -%}
write_restart run_{{ SIMNUMBER }}.data
